<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="دستیار صوتی حرفه‌ای" android:textSize="28sp" android:textStyle="bold"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="متوقف است" android:textSize="18sp" android:layout_marginTop="16dp"/>
<Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="شروع دستیار در پس‌زمینه" android:layout_marginTop="24dp"/>
<Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="توقف دستیار" android:layout_marginTop="10dp"/>
<TextView android:id="@+id/last" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="آخرین فرمان: -" android:textSize="16sp" android:layout_marginTop="24dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فرمان‌ها:&#10;«دستیار، گوگل رو باز کن»&#10;«دستیار، برو توی گوگل و سرچ کن Canva»&#10;«دستیار، تلگرام رو باز کن»&#10;«دستیار، دیسکورد رو باز کن»&#10;«دستیار، دانلودها رو باز کن»" android:textSize="16sp" android:layout_marginTop="18dp"/>
</LinearLayout></ScrollView>
